# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# `.env*` only matches names that START with .env, so a file called
# secrets.env or prod.env would have sailed straight into a commit.
*.env
# ...but the template MUST be committed, or a fresh clone has nothing to copy
# from and setup.sh has no key file to create. It holds names, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local env (API keys)
.env.local

# Playwright
/test-results/
/playwright-report/

# Anything else that tends to carry a secret
*.key
*.p12
id_rsa*

# Local agent/editor tooling — machine-specific, not part of the project
.claude/
